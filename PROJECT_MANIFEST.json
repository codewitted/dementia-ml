{
  "project": {
    "name": "Dementia Prediction using Multi-Modal Machine Learning",
    "version": "1.0.0",
    "type": "academic_research",
    "domain": "medical_ml",
    "status": "examiner_ready"
  },
  "metadata": {
    "description": "MSc/PhD dissertation project for early detection of dementia using clinical and neuroimaging data",
    "dataset": "OASIS (Open Access Series of Imaging Studies)",
    "dataset_alternative": "ADNI (documented pivot rationale)",
    "citation": "Marcus et al. (2007) - OASIS Cross-sectional MRI Data",
    "license": "MIT",
    "reproducibility": "Fixed random seeds (random_state=42), complete dependency specifications"
  },
  "models": {
    "tabular": {
      "logistic_regression": {
        "type": "classification",
        "library": "scikit-learn",
        "hyperparameters": {"max_iter": 1000, "random_state": 42}
      },
      "random_forest": {
        "type": "classification",
        "library": "scikit-learn",
        "hyperparameters": {"n_estimators": 100, "random_state": 42}
      },
      "gradient_boosting": {
        "type": "classification",
        "library": "scikit-learn",
        "hyperparameters": {"n_estimators": 100, "learning_rate": 0.1, "random_state": 42}
      }
    },
    "deep_learning": {
      "cnn_2d": {
        "type": "classification",
        "library": "pytorch",
        "architecture": "SimpleMRI2DCNN",
        "input_size": [128, 128],
        "num_classes": 2
      }
    },
    "ensemble": {
      "stacking": {
        "type": "meta_learning",
        "base_learners": ["logistic_regression", "random_forest", "gradient_boosting"],
        "meta_learner": "logistic_regression",
        "cv_folds": 5
      },
      "voting": {
        "type": "soft_voting",
        "estimators": ["logistic_regression", "random_forest", "gradient_boosting"]
      }
    }
  },
  "workflow": {
    "steps": [
      {
        "id": 1,
        "name": "data_provenance",
        "notebook": "notebooks/00_Data_Provenance_And_Access.ipynb",
        "description": "Document dataset selection rationale and access procedures"
      },
      {
        "id": 2,
        "name": "eda_preprocessing",
        "notebook": "notebooks/01_EDA_and_Preprocessing.ipynb",
        "description": "Exploratory data analysis and preprocessing pipeline"
      },
      {
        "id": 3,
        "name": "tabular_models",
        "notebook": "notebooks/02_Tabular_Models.ipynb",
        "script": "scripts/train_tabular.py",
        "description": "Train tabular models (LR, RF, GBM)",
        "outputs": ["models/logistic_regression.pkl", "models/random_forest.pkl", "models/gradient_boosting.pkl"]
      },
      {
        "id": 4,
        "name": "cnn_models",
        "notebook": "notebooks/03_CNN_Models.ipynb",
        "script": "scripts/train_cnn.py",
        "description": "Train CNN on MRI images",
        "outputs": ["models/cnn_model.pth"],
        "optional": true,
        "reason": "Requires MRI image data"
      },
      {
        "id": 5,
        "name": "ensemble_fusion",
        "notebook": "notebooks/04_Ensemble_Fusion.ipynb",
        "script": "scripts/train_ensemble.py",
        "description": "Create stacking and voting ensembles",
        "outputs": ["models/stacking_ensemble.pkl", "models/voting_ensemble.pkl"]
      },
      {
        "id": 6,
        "name": "explainability",
        "notebook": "notebooks/05_Explainability.ipynb",
        "description": "Generate SHAP values and feature importance",
        "outputs": ["outputs/feature_importance_summary.csv", "outputs/figures/shap_summary_rf.png"]
      },
      {
        "id": 7,
        "name": "results_reporting",
        "notebook": "notebooks/06_Results_and_Reporting.ipynb",
        "script": "scripts/evaluate_models.py",
        "description": "Generate publication-ready results",
        "outputs": [
          "outputs/tables/model_performance.csv",
          "outputs/tables/benchmark_comparison.csv",
          "outputs/figures/roc_curves.png",
          "outputs/EXECUTIVE_SUMMARY.txt"
        ]
      }
    ]
  },
  "execution": {
    "automated_pipeline": {
      "entry_point": "main.py",
      "command": "python main.py --mode full",
      "description": "One-click execution of entire pipeline"
    },
    "individual_scripts": [
      "python scripts/train_tabular.py",
      "python scripts/train_ensemble.py",
      "python scripts/evaluate_models.py"
    ],
    "interactive_notebooks": "jupyter lab",
    "ai_agent_mode": "python scripts/ai_agent_run.py --auto"
  },
  "outputs": {
    "models": {
      "directory": "models/",
      "files": ["*.pkl", "*.pth"]
    },
    "results": {
      "directory": "outputs/",
      "tables": "outputs/tables/*.csv",
      "figures": "outputs/figures/*.png",
      "summary": "outputs/EXECUTIVE_SUMMARY.txt"
    }
  },
  "dependencies": {
    "conda_env": "environment.yml",
    "pip_requirements": "requirements.txt",
    "python_version": "3.10+",
    "key_packages": [
      "scikit-learn>=1.0.0",
      "torch>=2.0.0",
      "pandas>=1.3.0",
      "shap>=0.41.0",
      "matplotlib>=3.4.0"
    ]
  },
  "validation": {
    "tests": "pytest tests/ -v",
    "checklist": "VALIDATION.md",
    "expected_metrics": {
      "accuracy_range": [0.80, 0.95],
      "auc_roc_range": [0.85, 0.95]
    }
  },
  "reproducibility": {
    "random_seeds": 42,
    "documentation": ["README.md", "QUICKSTART.md", "VALIDATION.md"],
    "configuration": "scripts/config.yaml",
    "verification_protocol": "Run all scripts with provided config, compare outputs with expected ranges"
  },
  "for_examiners": {
    "quick_start": "QUICKSTART.md",
    "full_documentation": "README.md",
    "validation_checklist": "VALIDATION.md",
    "one_click_run": "python main.py --mode full",
    "expected_runtime": "~30 minutes (tabular only, without MRI CNN)"
  },
  "api": {
    "available": true,
    "entry_point": "api/app.py",
    "server_command": "python api/app.py",
    "endpoint": "http://localhost:8000",
    "docs": "http://localhost:8000/docs",
    "description": "REST API for model predictions"
  }
}
